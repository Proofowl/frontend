{
  "name": "proofowl-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web frontend for ProofOwl: passport lookup, read-only wallet view, and the explainer for the on-chain contributor-reputation registry.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.6.0",
    "@noble/hashes": "^1.7.1",
    "@proofowl/contract-sdk": "file:../proofowl-contracts/sdk/typescript",
    "@stellar/stellar-sdk": "^16.0.1",
    "buffer": "^6.0.3",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
